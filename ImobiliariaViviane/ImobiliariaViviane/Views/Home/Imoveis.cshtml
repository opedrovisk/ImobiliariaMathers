@{
    ViewData["Title"] = "Resultados - Imobiliária Viviane de Souza";
}

@section Styles {
    <link href="~/css/global.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/imoveis.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            background: #f5f5f5;
        }

        .filtros-inline {
            margin-top: 1rem;
            background: #fff;
            border: 1px solid #e1e6f0;
            border-radius: 12px;
            padding: 0.9rem;
        }

        .filtros-inline-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.7rem;
        }

        .filtro-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .filtro-item label {
            font-size: 0.72rem;
            color: #586a82;
            font-weight: 700;
        }

        .filtro-item select {
            height: 38px;
            border: 1px solid #d2dbe8;
            border-radius: 8px;
            padding: 0 0.6rem;
            font-size: 0.9rem;
            color: #263b59;
            background: #fff;
        }

        .filtro-item input {
            height: 38px;
            border: 1px solid #d2dbe8;
            border-radius: 8px;
            padding: 0 0.6rem;
            font-size: 0.9rem;
            color: #263b59;
            background: #fff;
        }

        .filtros-inline-acoes {
            margin-top: 0.75rem;
            display: flex;
            gap: 0.6rem;
            justify-content: flex-end;
        }

        .btn-filtro {
            border: 0;
            border-radius: 8px;
            padding: 0.55rem 0.95rem;
            font-size: 0.86rem;
            font-weight: 700;
        }

        .btn-filtro-aplicar {
            background: #4A5FFF;
            color: #fff;
        }

        .btn-filtro-limpar {
            background: #edf2fb;
            color: #2d3f58;
        }

        .paginacao-imoveis {
            margin-top: 1.8rem;
            display: flex;
            justify-content: center;
        }

        .paginacao-imoveis .pagination {
            margin-bottom: 0;
        }

        .paginacao-imoveis .page-link {
            color: #2b3f61;
            font-weight: 700;
        }

        .paginacao-imoveis .page-item.active .page-link {
            background-color: #4A5FFF;
            border-color: #4A5FFF;
        }

        @@media (max-width: 992px) {
            .filtros-inline-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 576px) {
            .filtros-inline-grid {
                grid-template-columns: 1fr;
            }

            .filtros-inline-acoes {
                justify-content: stretch;
            }

            .btn-filtro {
                flex: 1;
            }
        }
    </style>
}

<partial name="_Header" />

<div id="imoveis-app" v-cloak>
    <main class="imoveis-main">
        <section class="filtros-aplicados">
            <div class="container">
                <div class="filtros-info">
                    <h1>Imóveis Encontrados</h1>
                    <p id="filtros-texto">[[ textoFiltros ]]</p>
                </div>
            </div>

            <div class="container">
                <div class="filtros-inline">
                    <div class="filtros-inline-grid">
                        <div class="filtro-item">
                            <label>Tipo</label>
                            <select v-model="filtros.tipo">
                                <option value="">Todos</option>
                                <option value="casa">Casa</option>
                                <option value="apartamento">Apartamento</option>
                            </select>
                        </div>

                        <div class="filtro-item">
                            <label>Negócio</label>
                            <select v-model="filtros.negocio">
                                <option value="">Todos</option>
                                <option value="compra">Compra</option>
                                <option value="aluguel">Aluguel</option>
                            </select>
                        </div>

                        <div class="filtro-item">
                            <label>Garagem</label>
                            <select v-model="filtros.garagem">
                                <option value="">Todos</option>
                                <option value="true">Com Garagem</option>
                                <option value="false">Sem Garagem</option>
                            </select>
                        </div>

                        <div class="filtro-item">
                            <label>Dormitórios</label>
                            <select v-model="filtros.dormitorios">
                                <option value="">Todos</option>
                                <option value="1">1 dormitório</option>
                                <option value="2">2 dormitórios</option>
                                <option value="3">3 dormitórios</option>
                                <option value="4">4 dormitórios</option>
                                <option value="5">5 ou mais</option>
                            </select>
                        </div>

                        <div class="filtro-item">
                            <label>Área</label>
                            <select v-model="filtros.espaco">
                                <option value="">Todos</option>
                                <option value="0-50">0-50 m²</option>
                                <option value="51-100">51-100 m²</option>
                                <option value="101-150">101-150 m²</option>
                                <option value="150+">Mais de 150 m²</option>
                            </select>
                        </div>

                        <div class="filtro-item">
                            <label>Estado (UF)</label>
                            <select v-model="filtros.estado">
                                <option value="">Todos</option>
                                <option v-for="uf in estadosDisponiveis" :key="`uf-${uf}`" :value="uf">[[ uf ]]</option>
                            </select>
                        </div>

                        <div class="filtro-item">
                            <label>Cidade</label>
                            <input type="text" maxlength="100" placeholder="Ex: São Paulo"
                                   v-model.trim="filtros.cidade" />
                        </div>

                        <div class="filtro-item">
                            <label>Bairro</label>
                            <input type="text" maxlength="100" placeholder="Ex: Centro" v-model.trim="filtros.bairro" />
                        </div>

                        <div class="filtro-item">
                            <label>Área mínima (m²)</label>
                            <input type="number" min="0" step="1" placeholder="Ex: 60"
                                   v-model.number="filtros.areaMin" />
                        </div>

                        <div class="filtro-item">
                            <label>Área máxima (m²)</label>
                            <input type="number" min="0" step="1" placeholder="Ex: 180"
                                   v-model.number="filtros.areaMax" />
                        </div>
                    </div>

                    <div class="filtros-inline-acoes">
                        <button type="button" class="btn-filtro btn-filtro-limpar"
                        @@click="limparFiltros">Limpar</button>
                        <button type="button" class="btn-filtro btn-filtro-aplicar"
                        @@click="aplicarFiltros">Filtrar</button>
                    </div>
                </div>
            </div>
        </section>

        <section class="imoveis-container">
            <div class="container">
                <div class="row" v-if="carregando">
                    <div class="col-12 text-center py-4 text-muted">Carregando imóveis...</div>
                </div>

                <div class="row g-4" v-else-if="imoveisFiltrados.length > 0">
                    <div class="col-12 col-md-6 col-lg-3" v-for="imovel in imoveisPaginados" :key="imovel.id">
                        <div class="card-imovel">
                            <div class="card-imovel-imagem">
                                <img :src="imovel.imagem" :alt="imovel.titulo" />
                                <span class="badge-tipo">[[ imovel.tipo === 'casa' ? 'Casa' : 'Apartamento' ]]</span>
                            </div>
                            <div class="card-imovel-conteudo">
                                <h3 class="card-imovel-titulo">[[ imovel.titulo ]]</h3>
                                <p class="card-imovel-endereco">
                                    <i class="bi bi-geo-alt"></i> [[ imovel.endereco ]]
                                </p>
                                <p class="card-imovel-descricao">[[ imovel.descricao ]]</p>
                                <div class="card-imovel-detalhes">
                                    <span><i class="bi bi-door-closed"></i> [[ imovel.dormitorios ]] dorm.</span>
                                    <span><i class="bi bi-rulers"></i> [[ imovel.area ]] m²</span>
                                    <span><i class="bi bi-car-front"></i> [[ imovel.garagem ? 'Com garagem' : 'Sem garagem' ]]</span>
                                    </div>
                                    <div class="card-imovel-footer">
                                        <span class="card-imovel-preco">[[ formatarPreco(imovel.preco) ]]</span>
                                        <button class="btn-ver-mais" @@click="abrirModal(imovel)">Ver mais</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 paginacao-imoveis" v-if="totalPaginas > 1">
                            <nav aria-label="Paginação de imóveis">
                                <ul class="pagination">
                                    <li class="page-item" :class="{ disabled: paginaAtual === 1 }">
                                        <button class="page-link" type="button" @@click="irParaPagina(paginaAtual - 1)">
                                            Anterior
                                        </button>
                                    </li>
                                    <li class="page-item" v-for="pagina in totalPaginas" :key="`p-${pagina}`"
                                        :class="{ active: pagina === paginaAtual }">
                                        <button class="page-link" type="button" @@click="irParaPagina(pagina)">[[ pagina
                                            ]]</button>
                                        </li>
                                        <li class="page-item" :class="{ disabled: paginaAtual === totalPaginas }">
                                            <button class="page-link" type="button" @@click="irParaPagina(paginaAtual + 1)">
                                                Próxima
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>

                        <div class="row" v-else>
                            <div class="col-12">
                                <div class="sem-resultados">
                                    <i class="bi bi-house-x"></i>
                                    <h3>Nenhum imóvel encontrado</h3>
                                    <p>Não encontramos imóveis que correspondam aos seus filtros.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </main>

            <div class="modal fade" id="modalImovel" tabindex="-1" aria-labelledby="modalImovelLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalImovelLabel">Detalhes do Imóvel</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-4">
                                <div class="col-lg-6">
                                    <div id="carouselImovel" class="carousel slide" data-bs-ride="carousel">
                                        <div class="carousel-indicators">
                                            <button v-for="(imagem, indice) in imagensModal" :key="`indicator-${indice}`"
                                                    type="button" data-bs-target="#carouselImovel" :data-bs-slide-to="indice"
                                                    :class="{ active: indice === 0 }" :aria-current="indice === 0 ? 'true' : null"
                                                    :aria-label="`Slide ${indice + 1}`"></button>
                                        </div>
                                        <div class="carousel-inner">
                                            <div v-for="(imagem, indice) in imagensModal" :key="`imagem-${indice}`"
                                                 class="carousel-item" :class="{ active: indice === 0 }">
                                                <img :src="imagem"
                                                     :alt="(imovelSelecionado.titulo || 'Imóvel') + ` - Foto ${indice + 1}`" />
                                            </div>
                                        </div>
                                        <button v-if="imagensModal.length > 1" class="carousel-control-prev" type="button"
                                                data-bs-target="#carouselImovel" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Anterior</span>
                                        </button>
                                        <button v-if="imagensModal.length > 1" class="carousel-control-next" type="button"
                                                data-bs-target="#carouselImovel" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Próximo</span>
                                        </button>
                                    </div>
                                    <a :href="whatsappLink" target="_blank" rel="noopener noreferrer"
                                           class="btn btn-success w-100 mt-3">
                                        <i class="bi bi-whatsapp"></i> Falar no WhatsApp
                                    </a>
                                </div>

                                <div class="col-lg-6">
                                    <div class="imovel-detalhes-modal">
                                        <span class="badge-tipo-modal">[[ imovelSelecionado.tipo === 'casa' ? 'Casa' :
                                            'Apartamento' ]]</span>
                                            <h2 class="imovel-titulo-modal">[[ imovelSelecionado.titulo || 'Título do Imóvel' ]]
                                            </h2>
                                            <p class="imovel-preco-modal">[[ formatarPreco(imovelSelecionado.preco) ]]</p>

                                            <div class="imovel-info-localizacao">
                                                <i class="bi bi-geo-alt-fill"></i>
                                                <span>[[ imovelSelecionado.endereco || 'Endereço' ]]</span>
                                            </div>

                                            <div class="imovel-caracteristicas">
                                                <h3>Características</h3>
                                                <div class="caracteristicas-grid">
                                                    <div class="caracteristica-item">
                                                        <i class="bi bi-door-closed-fill"></i>
                                                        <div>
                                                            <span class="caracteristica-label">Dormitórios</span>
                                                            <span class="caracteristica-valor">[[ imovelSelecionado.dormitorios || 0
                                                                ]]</span>
                                                            </div>
                                                        </div>
                                                        <div class="caracteristica-item">
                                                            <i class="bi bi-rulers"></i>
                                                            <div>
                                                                <span class="caracteristica-label">Área</span>
                                                                <span class="caracteristica-valor">[[ imovelSelecionado.area || 0 ]]
                                                                    m²</span>
                                                                </div>
                                                            </div>
                                                            <div class="caracteristica-item">
                                                                <i class="bi bi-car-front-fill"></i>
                                                                <div>
                                                                    <span class="caracteristica-label">Garagem</span>
                                                                    <span class="caracteristica-valor">[[ imovelSelecionado.garagem ? 'Sim'
                                                                        : 'Não' ]]</span>
                                                                    </div>
                                                                </div>
                                                                <div class="caracteristica-item">
                                                                    <i class="bi bi-house-fill"></i>
                                                                    <div>
                                                                        <span class="caracteristica-label">Tipo</span>
                                                                        <span class="caracteristica-valor">[[ imovelSelecionado.tipo === 'casa'
                                                                            ? 'Casa' : 'Apartamento' ]]</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="imovel-descricao-modal">
                                                                <h3>Sobre o Imóvel</h3>
                                                                <p>[[ imovelSelecionado.descricao || 'Descrição do imóvel' ]]</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @section Scripts {
                                <script>
                                    const imoveisApp = Vue.createApp({
                                        delimiters: ['[[', ']]'],
                                        data() {
                                            return {
                                                filtros: {
                                                    tipo: '',
                                                    negocio: '',
                                                    garagem: '',
                                                    dormitorios: '',
                                                    espaco: '',
                                                    estado: '',
                                                    cidade: '',
                                                    bairro: '',
                                                    areaMin: null,
                                                    areaMax: null
                                                },
                                                imoveis: [],
                                                carregando: true,
                                                paginaAtual: 1,
                                                itensPorPagina: 8,
                                                imovelSelecionado: {}
                                            };
                                        },
                                        computed: {
                                            estadosDisponiveis() {
                                                const estados = this.imoveis
                                                    .map(i => String(i.estado || '').trim().toUpperCase())
                                                    .filter(Boolean);

                                                return [...new Set(estados)].sort();
                                            },
                                            imagensModal() {
                                                const imagens = Array.isArray(this.imovelSelecionado.imagens)
                                                    ? this.imovelSelecionado.imagens.filter(img => !!img)
                                                    : [];

                                                if (imagens.length > 0) {
                                                    return imagens;
                                                }

                                                if (this.imovelSelecionado.imagem) {
                                                    return [this.imovelSelecionado.imagem];
                                                }

                                                return ['/assets/placeholder01.jpg'];
                                            },
                                            whatsappLink() {
                                                const numeroPlaceholder = '5500000000000';
                                                const titulo = this.imovelSelecionado?.titulo || 'um imóvel';
                                                const mensagem = encodeURIComponent(`Olá! Tenho interesse em ${titulo}.`);
                                                return `https://wa.me/${numeroPlaceholder}?text=${mensagem}`;
                                            },
                                            imoveisFiltrados() {
                                                const cidadeFiltro = String(this.filtros.cidade || '').toLowerCase();
                                                const bairroFiltro = String(this.filtros.bairro || '').toLowerCase();

                                                return this.imoveis.filter(imovel => {
                                                    const negocio = String(imovel.negocio || '').toLowerCase();
                                                    const estado = String(imovel.estado || '').toUpperCase();
                                                    const cidade = String(imovel.cidade || '').toLowerCase();
                                                    const bairro = String(imovel.bairro || '').toLowerCase();
                                                    const area = Number(imovel.area || 0);

                                                    if (this.filtros.tipo && imovel.tipo !== this.filtros.tipo) return false;
                                                    if (this.filtros.negocio && negocio !== this.filtros.negocio) return false;

                                                    if (this.filtros.garagem === 'true' && !imovel.garagem) return false;
                                                    if (this.filtros.garagem === 'false' && !!imovel.garagem) return false;

                                                    if (this.filtros.dormitorios) {
                                                        const dormFiltro = Number(this.filtros.dormitorios);
                                                        const dorms = Number(imovel.dormitorios || 0);
                                                        if (dormFiltro >= 5 && dorms < 5) return false;
                                                        if (dormFiltro < 5 && dorms !== dormFiltro) return false;
                                                    }

                                                    if (this.filtros.espaco) {
                                                        if (this.filtros.espaco === '0-50' && area > 50) return false;
                                                        if (this.filtros.espaco === '51-100' && (area <= 50 || area > 100)) return false;
                                                        if (this.filtros.espaco === '101-150' && (area <= 100 || area > 150)) return false;
                                                        if (this.filtros.espaco === '150+' && area <= 150) return false;
                                                    }

                                                    if (this.filtros.estado && estado !== this.filtros.estado) return false;
                                                    if (cidadeFiltro && !cidade.includes(cidadeFiltro)) return false;
                                                    if (bairroFiltro && !bairro.includes(bairroFiltro)) return false;

                                                    if (this.filtros.areaMin !== null && this.filtros.areaMin !== '' && area < Number(this.filtros.areaMin)) return false;
                                                    if (this.filtros.areaMax !== null && this.filtros.areaMax !== '' && area > Number(this.filtros.areaMax)) return false;

                                                    return true;
                                                });
                                            },
                                            totalPaginas() {
                                                return Math.max(1, Math.ceil(this.imoveisFiltrados.length / this.itensPorPagina));
                                            },
                                            imoveisPaginados() {
                                                const inicio = (this.paginaAtual - 1) * this.itensPorPagina;
                                                return this.imoveisFiltrados.slice(inicio, inicio + this.itensPorPagina);
                                            },
                                            textoFiltros() {
                                                const ativos = [];
                                                if (this.filtros.tipo) ativos.push(this.filtros.tipo === 'casa' ? 'Casa' : 'Apartamento');
                                                if (this.filtros.negocio) ativos.push(this.filtros.negocio === 'compra' ? 'Compra' : 'Aluguel');
                                                if (this.filtros.garagem) ativos.push(this.filtros.garagem === 'true' ? 'Com Garagem' : 'Sem Garagem');
                                                if (this.filtros.dormitorios) {
                                                    const num = Number(this.filtros.dormitorios);
                                                    ativos.push(`${num >= 5 ? '5+' : num} dormitório${num > 1 ? 's' : ''}`);
                                                }
                                                if (this.filtros.espaco) {
                                                    const mapa = {
                                                        '0-50': '0-50 m²',
                                                        '51-100': '51-100 m²',
                                                        '101-150': '101-150 m²',
                                                        '150+': 'Mais de 150 m²'
                                                    };
                                                    ativos.push(mapa[this.filtros.espaco]);
                                                }
                                                if (this.filtros.estado) ativos.push(`UF ${this.filtros.estado}`);
                                                if (this.filtros.cidade) ativos.push(`Cidade: ${this.filtros.cidade}`);
                                                if (this.filtros.bairro) ativos.push(`Bairro: ${this.filtros.bairro}`);
                                                if (this.filtros.areaMin !== null && this.filtros.areaMin !== '') ativos.push(`Área mín: ${this.filtros.areaMin} m²`);
                                                if (this.filtros.areaMax !== null && this.filtros.areaMax !== '') ativos.push(`Área máx: ${this.filtros.areaMax} m²`);

                                                return ativos.length > 0
                                                    ? `Filtros aplicados: ${ativos.join(' • ')}`
                                                    : 'Exibindo todos os imóveis disponíveis';
                                            }
                                        },
                                        methods: {
                                            carregarFiltrosURL() {
                                                const params = new URLSearchParams(window.location.search);
                                                this.filtros.tipo = params.get('tipo') || '';
                                                this.filtros.negocio = params.get('negocio') || '';
                                                this.filtros.garagem = params.get('garagem') || '';
                                                this.filtros.dormitorios = params.get('dormitorios') || '';
                                                this.filtros.espaco = params.get('espaco') || '';
                                                this.filtros.estado = String(params.get('estado') || '').toUpperCase();
                                                this.filtros.cidade = params.get('cidade') || '';
                                                this.filtros.bairro = params.get('bairro') || '';
                                                this.filtros.areaMin = params.get('areaMin') || null;
                                                this.filtros.areaMax = params.get('areaMax') || null;
                                            },
                                            montarQueryString() {
                                                const params = new URLSearchParams();
                                                if (this.filtros.tipo) params.append('tipo', this.filtros.tipo);
                                                if (this.filtros.negocio) params.append('negocio', this.filtros.negocio);
                                                if (this.filtros.garagem) params.append('garagem', this.filtros.garagem);
                                                if (this.filtros.dormitorios) params.append('dormitorios', this.filtros.dormitorios);
                                                if (this.filtros.espaco) params.append('espaco', this.filtros.espaco);
                                                if (this.filtros.estado) params.append('estado', this.filtros.estado);
                                                if (this.filtros.cidade) params.append('cidade', this.filtros.cidade);
                                                if (this.filtros.bairro) params.append('bairro', this.filtros.bairro);
                                                if (this.filtros.areaMin !== null && this.filtros.areaMin !== '') params.append('areaMin', String(this.filtros.areaMin));
                                                if (this.filtros.areaMax !== null && this.filtros.areaMax !== '') params.append('areaMax', String(this.filtros.areaMax));
                                                return params.toString();
                                            },
                                            aplicarFiltros() {
                                                this.paginaAtual = 1;
                                                this.carregarImoveis();
                                            },
                                            limparFiltros() {
                                                this.filtros = {
                                                    tipo: '',
                                                    negocio: '',
                                                    garagem: '',
                                                    dormitorios: '',
                                                    espaco: '',
                                                    estado: '',
                                                    cidade: '',
                                                    bairro: '',
                                                    areaMin: null,
                                                    areaMax: null
                                                };
                                                this.paginaAtual = 1;
                                                this.carregarImoveis();
                                            },
                                            async carregarImoveis() {
                                                this.carregando = true;
                                                try {
                                                    const queryString = this.montarQueryString();
                                                    const novaUrl = queryString
                                                        ? `${window.location.pathname}?${queryString}`
                                                        : window.location.pathname;
                                                    window.history.replaceState({}, '', novaUrl);

                                                    const response = await fetch(`/Home/BuscarImoveis?${queryString}`);
                                                    if (!response.ok) throw new Error('Erro ao buscar imóveis');
                                                    const data = await response.json();
                                                    this.imoveis = Array.isArray(data) ? data : [];
                                                    this.paginaAtual = 1;
                                                } catch {
                                                    this.imoveis = [];
                                                } finally {
                                                    this.carregando = false;
                                                }
                                            },
                                            irParaPagina(pagina) {
                                                if (pagina < 1 || pagina > this.totalPaginas) {
                                                    return;
                                                }

                                                this.paginaAtual = pagina;
                                                window.scrollTo({ top: 0, behavior: 'smooth' });
                                            },
                                            formatarPreco(valor) {
                                                if (typeof valor !== 'number') return valor || 'R$ 0,00';
                                                return valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                                            },
                                            abrirModal(imovel) {
                                                this.imovelSelecionado = imovel;
                                                const modal = new bootstrap.Modal(document.getElementById('modalImovel'));
                                                modal.show();
                                            }
                                        },
                                        mounted() {
                                            this.carregarFiltrosURL();
                                            this.carregarImoveis();
                                        }
                                    });

                                    try {
                                        imoveisApp.mount('#imoveis-app');
                                    } catch (error) {
                                        const appRoot = document.getElementById('imoveis-app');
                                        if (appRoot) {
                                            appRoot.removeAttribute('v-cloak');
                                        }

                                        console.error('Falha ao inicializar a tela de imóveis:', error);
                                    }
                                </script>
                            }
