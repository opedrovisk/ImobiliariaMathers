@{
    ViewData["Title"] = "Cadastrar Imóvel - Imobiliária Viviane de Souza";
}

@section Styles {
    <link href="~/css/global.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/cadastro.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .cadastro-preview-grid {
            margin-top: 0.65rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
            gap: 0.6rem;
        }

        .cadastro-preview-item {
            position: relative;
            border: 1px solid #d7deea;
            border-radius: 8px;
            overflow: hidden;
            background: #f6f9ff;
        }

        .cadastro-preview-remover {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 22px;
            height: 22px;
            border: 0;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.92);
            color: #cf2b2b;
            font-size: 0.95rem;
            font-weight: 700;
            line-height: 1;
            cursor: pointer;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
        }

        .cadastro-preview-remover:hover {
            background: #fff;
            color: #b61f1f;
        }

        .cadastro-preview-item img {
            width: 100%;
            height: 88px;
            object-fit: cover;
            display: block;
        }

        .cadastro-preview-item span {
            display: block;
            font-size: 0.7rem;
            color: #55657d;
            padding: 0.3rem 0.45rem 0.4rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #cadastro-toast {
            width: fit-content;
            max-width: min(92vw, 460px);
        }

        #cadastro-toast .toast-body {
            white-space: nowrap;
        }
    </style>
}

<main>
    <partial name="_Header" />

    <div id="cadastro-banner">
        <img src="~/assets/fotofamilia.jpg" alt="Banner Cadastro" class="img-fluid blur-background" />

        <div class="overlay-content">
            <div class="cadastro-form-container">
                <h1 class="form-title">Cadastrar Novo Imóvel</h1>

                <form class="cadastro-form" id="form-cadastro">
                    <div class="form-group span-2">
                        <i class="bi bi-card-heading"></i>
                        <div class="form-input-wrapper">
                            <label>Título *</label>
                            <input type="text" id="cadastro-titulo" placeholder="Ex: Casa ampla com quintal"
                                   maxlength="150" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-house-door"></i>
                        <div class="form-input-wrapper">
                            <label>Tipo *</label>
                            <select id="cadastro-tipo" required>
                                <option value="">Selecionar Tipo</option>
                                <option value="CASA">Casa</option>
                                <option value="APARTAMENTO">Apartamento</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-tag"></i>
                        <div class="form-input-wrapper">
                            <label>Tipo de Negócio *</label>
                            <select id="cadastro-negocio" required>
                                <option value="">Selecionar</option>
                                <option value="compra">Compra</option>
                                <option value="aluguel">Aluguel</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-geo-alt"></i>
                        <div class="form-input-wrapper">
                            <label>Bairro</label>
                            <input type="text" id="cadastro-bairro" placeholder="Digite o bairro" maxlength="100" />
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-building"></i>
                        <div class="form-input-wrapper">
                            <label>Cidade *</label>
                            <input type="text" id="cadastro-cidade" placeholder="Digite a cidade" maxlength="100"
                                   required />
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-map"></i>
                        <div class="form-input-wrapper">
                            <label>Estado (UF) *</label>
                            <input type="text" id="cadastro-estado" placeholder="Ex: SP" maxlength="2" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-mailbox"></i>
                        <div class="form-input-wrapper">
                            <label>CEP</label>
                            <input type="text" id="cadastro-cep" placeholder="Ex: 00000-000" maxlength="9" />
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-door-closed"></i>
                        <div class="form-input-wrapper">
                            <label>Dormitórios *</label>
                            <select id="cadastro-dormitorios" required>
                                <option value="">Selecionar Dormitórios</option>
                                <option value="1">1 dormitório</option>
                                <option value="2">2 dormitórios</option>
                                <option value="3">3 dormitórios</option>
                                <option value="4">4 dormitórios</option>
                                <option value="5">5 ou mais dormitórios</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-car-front"></i>
                        <div class="form-input-wrapper">
                            <label>Garagem *</label>
                            <select id="cadastro-garagem" required>
                                <option value="">Selecionar Garagem</option>
                                <option value="true">Com Garagem</option>
                                <option value="false">Sem Garagem</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-rulers"></i>
                        <div class="form-input-wrapper">
                            <label>Espaço (m²) *</label>
                            <input type="number" id="cadastro-espaco" placeholder="Ex: 75" min="1" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <i class="bi bi-currency-dollar"></i>
                        <div class="form-input-wrapper">
                            <label>Valor (R$) *</label>
                            <input type="text" id="cadastro-valor" placeholder="Ex: R$ 250.000,00" inputmode="numeric"
                                   required />
                        </div>
                    </div>

                    <div class="form-group span-2">
                        <i class="bi bi-card-text"></i>
                        <div class="form-input-wrapper">
                            <label>Descrição</label>
                            <textarea id="cadastro-descricao" placeholder="Descreva o imóvel..." rows="3"></textarea>
                        </div>
                    </div>

                    <div class="form-group upload-group span-2">
                        <i class="bi bi-image"></i>
                        <div class="form-input-wrapper">
                            <label>Imagens do Imóvel</label>
                            <input type="file" id="cadastro-imagens" accept="image/*" multiple class="file-input" />
                            <div class="file-info">Selecione uma ou mais imagens</div>
                            <div id="cadastro-preview-grid" class="cadastro-preview-grid" aria-live="polite"></div>
                        </div>
                    </div>

                    <div class="form-buttons">
                        <a asp-controller="Home" asp-action="Index" class="btn-cancelar">Cancelar</a>
                        <button type="submit" class="btn-cadastrar">
                            Cadastrar Imóvel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<form id="csrf-form" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
    <div id="cadastro-toast" class="toast align-items-center text-bg-success border-0" role="alert"
         aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="cadastro-toast-body">
                Imóvel cadastrado com sucesso.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const MAX_LADO_IMAGEM = 1600;
        const QUALIDADE_INICIAL_JPEG = 0.78;
        const QUALIDADE_MINIMA_JPEG = 0.45;
        const LIMITE_IMAGEM_BYTES = 700 * 1024;
        const LIMITE_TOTAL_BYTES = 3 * 1024 * 1024;

        const cadastroToastElement = document.getElementById('cadastro-toast');
        const cadastroToastBody = document.getElementById('cadastro-toast-body');
        const cadastroToast = cadastroToastElement ? new bootstrap.Toast(cadastroToastElement, { delay: 1600 }) : null;
        const previewGrid = document.getElementById('cadastro-preview-grid');
        const inputImagens = document.getElementById('cadastro-imagens');
        const fileInfoImagens = inputImagens ? inputImagens.parentElement.querySelector('.file-info') : null;
        const csrfToken = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';
        const previewObjectUrls = [];
        let imagensSelecionadas = [];

        function showCadastroToast(message) {
            if (!cadastroToast || !cadastroToastBody) return;
            cadastroToastBody.textContent = message;
            cadastroToast.show();
        }

        function formatarMoedaBRL(valor) {
            return valor.toLocaleString('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            });
        }

        function extrairNumeroMoeda(valorTexto) {
            const apenasDigitos = String(valorTexto || '').replace(/\D/g, '');
            if (!apenasDigitos) {
                return 0;
            }

            return Number(apenasDigitos) / 100;
        }

        function aplicarMascaraMoeda(input) {
            const valor = extrairNumeroMoeda(input.value);
            input.value = valor > 0 ? formatarMoedaBRL(valor) : '';
        }

        function formatarCep(valor) {
            const digitos = String(valor || '').replace(/\D/g, '').slice(0, 8);
            if (digitos.length <= 5) {
                return digitos;
            }

            return `${digitos.slice(0, 5)}-${digitos.slice(5)}`;
        }

        function limparPreviewsImagens() {
            while (previewObjectUrls.length > 0) {
                const url = previewObjectUrls.pop();
                URL.revokeObjectURL(url);
            }

            if (previewGrid) {
                previewGrid.innerHTML = '';
            }
        }

        function atualizarInfoImagens() {
            if (!fileInfoImagens) {
                return;
            }

            if (imagensSelecionadas.length > 0) {
                fileInfoImagens.textContent = `${imagensSelecionadas.length} imagem(ns) selecionada(s)`;
            } else {
                fileInfoImagens.textContent = 'Selecione uma ou mais imagens';
            }
        }

        function sincronizarInputImagens() {
            if (!inputImagens) {
                return;
            }

            const dataTransfer = new DataTransfer();
            imagensSelecionadas.forEach(file => dataTransfer.items.add(file));
            inputImagens.files = dataTransfer.files;
        }

        function removerImagemSelecionada(index) {
            if (index < 0 || index >= imagensSelecionadas.length) {
                return;
            }

            imagensSelecionadas.splice(index, 1);
            sincronizarInputImagens();
            atualizarInfoImagens();
            renderizarPreviewsImagens(imagensSelecionadas);
        }

        function renderizarPreviewsImagens(files) {
            limparPreviewsImagens();
            if (!previewGrid || files.length === 0) {
                return;
            }

            const fragment = document.createDocumentFragment();

            files.forEach((file, index) => {
                const objectUrl = URL.createObjectURL(file);
                previewObjectUrls.push(objectUrl);

                const item = document.createElement('div');
                item.className = 'cadastro-preview-item';

                const imagem = document.createElement('img');
                imagem.src = objectUrl;
                imagem.alt = `Preview ${index + 1}`;

                const remover = document.createElement('button');
                remover.type = 'button';
                remover.className = 'cadastro-preview-remover';
                remover.title = 'Remover imagem';
                remover.setAttribute('aria-label', `Remover ${file.name}`);
                remover.textContent = 'x';
                remover.addEventListener('click', () => removerImagemSelecionada(index));

                const legenda = document.createElement('span');
                legenda.textContent = file.name;
                legenda.title = file.name;

                item.appendChild(imagem);
                item.appendChild(remover);
                item.appendChild(legenda);
                fragment.appendChild(item);
            });

            previewGrid.appendChild(fragment);
        }

        function calcularBytesDataUrl(dataUrl) {
            const base64 = (dataUrl.split(',')[1] || '');
            return Math.ceil((base64.length * 3) / 4);
        }

        function carregarImagemArquivo(file) {
            return new Promise((resolve, reject) => {
                const objectUrl = URL.createObjectURL(file);
                const image = new Image();
                image.onload = () => {
                    URL.revokeObjectURL(objectUrl);
                    resolve(image);
                };
                image.onerror = () => {
                    URL.revokeObjectURL(objectUrl);
                    reject(new Error('Falha ao carregar imagem selecionada.'));
                };
                image.src = objectUrl;
            });
        }

        async function fileToDataUrl(file) {
            if (!file.type || !file.type.startsWith('image/')) {
                throw new Error('Selecione apenas arquivos de imagem.');
            }

            const imagem = await carregarImagemArquivo(file);
            const escala = Math.min(1, MAX_LADO_IMAGEM / imagem.width, MAX_LADO_IMAGEM / imagem.height);
            const largura = Math.max(1, Math.round(imagem.width * escala));
            const altura = Math.max(1, Math.round(imagem.height * escala));

            const canvas = document.createElement('canvas');
            canvas.width = largura;
            canvas.height = altura;

            const contexto = canvas.getContext('2d');
            if (!contexto) {
                throw new Error('Não foi possível processar a imagem selecionada.');
            }

            contexto.drawImage(imagem, 0, 0, largura, altura);

            let qualidade = QUALIDADE_INICIAL_JPEG;
            let dataUrl = canvas.toDataURL('image/jpeg', qualidade);

            while (calcularBytesDataUrl(dataUrl) > LIMITE_IMAGEM_BYTES && qualidade > QUALIDADE_MINIMA_JPEG) {
                qualidade = Math.max(QUALIDADE_MINIMA_JPEG, qualidade - 0.08);
                dataUrl = canvas.toDataURL('image/jpeg', qualidade);
            }

            if (calcularBytesDataUrl(dataUrl) > LIMITE_IMAGEM_BYTES) {
                throw new Error(`A imagem "${file.name}" está muito grande. Use uma imagem menor.`);
            }

            return dataUrl;
        }

        const textarea = document.getElementById('cadastro-descricao');
        textarea.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = this.scrollHeight + 'px';
        });

        const inputPreco = document.getElementById('cadastro-valor');
        inputPreco.addEventListener('input', function () {
            aplicarMascaraMoeda(this);
        });

        inputPreco.addEventListener('blur', function () {
            if (!this.value) {
                return;
            }

            aplicarMascaraMoeda(this);
        });

        const inputCep = document.getElementById('cadastro-cep');
        inputCep.addEventListener('input', function () {
            this.value = formatarCep(this.value);
        });

        inputCep.addEventListener('blur', function () {
            this.value = formatarCep(this.value);
        });

        inputImagens.addEventListener('change', function (e) {
            const novosArquivos = Array.from(e.target.files || []);
            if (novosArquivos.length === 0) {
                return;
            }

            const assinaturasExistentes = new Set(
                imagensSelecionadas.map(file => `${file.name}_${file.size}_${file.lastModified}`)
            );

            novosArquivos.forEach(file => {
                const assinatura = `${file.name}_${file.size}_${file.lastModified}`;
                if (!assinaturasExistentes.has(assinatura)) {
                    imagensSelecionadas.push(file);
                    assinaturasExistentes.add(assinatura);
                }
            });

            sincronizarInputImagens();
            atualizarInfoImagens();
            renderizarPreviewsImagens(imagensSelecionadas);
            this.value = '';
        });

        window.addEventListener('beforeunload', limparPreviewsImagens);

        document.getElementById('form-cadastro').addEventListener('submit', async function (e) {
            e.preventDefault();

            let imagensBase64 = [];

            try {
                imagensBase64 = await Promise.all(imagensSelecionadas.map(fileToDataUrl));
            } catch (erroImagem) {
                alert(erroImagem.message || 'Não foi possível processar as imagens selecionadas.');
                return;
            }

            const totalBytes = imagensBase64.reduce((acc, img) => acc + calcularBytesDataUrl(img), 0);
            if (totalBytes > LIMITE_TOTAL_BYTES) {
                alert('As imagens selecionadas somadas ficaram muito grandes. Selecione menos imagens ou imagens menores.');
                return;
            }

            const formData = {
                titulo: document.getElementById('cadastro-titulo').value,
                tipo: document.getElementById('cadastro-tipo').value,
                negocio: document.getElementById('cadastro-negocio').value,
                bairro: document.getElementById('cadastro-bairro').value,
                cidade: document.getElementById('cadastro-cidade').value,
                estado: document.getElementById('cadastro-estado').value,
                cep: document.getElementById('cadastro-cep').value,
                dormitorios: Number(document.getElementById('cadastro-dormitorios').value),
                garagem: document.getElementById('cadastro-garagem').value === 'true',
                areaM2: Number(document.getElementById('cadastro-espaco').value),
                preco: extrairNumeroMoeda(document.getElementById('cadastro-valor').value),
                descricao: document.getElementById('cadastro-descricao').value,
                imagens: imagensBase64
            };

            try {
                const response = await fetch('/Home/CadastrarImovel', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify(formData)
                });

                if (response.status === 401) {
                    alert('Sua sessão expirou. Faça login novamente.');
                    window.location.href = '/Home/Login';
                    return;
                }

                if (response.status === 403) {
                    alert('Apenas usuários administradores podem cadastrar imóveis.');
                    window.location.href = '/Home/Index';
                    return;
                }

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.mensagem || 'Não foi possível cadastrar o imóvel.');
                }

                showCadastroToast('Imóvel cadastrado com sucesso.');
                window.setTimeout(() => {
                    window.location.href = '/Home/Index';
                }, 1200);
            } catch (error) {
                alert(error.message || 'Erro ao cadastrar imóvel.');
            }
        });
    </script>
}
