@{
    ViewData["Title"] = "Alterar Imóveis - Imobiliária Viviane de Souza";
}

@section Styles {
    <link href="~/css/global.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body {
            background: #111827;
        }

        [v-cloak] {
            display: none;
        }

        .alterar-page {
            min-height: 100vh;
            background: linear-gradient(rgba(16, 20, 28, 0.78), rgba(16, 20, 28, 0.85)),
                url('/assets/change.jpg') center center / cover no-repeat fixed;
            padding-bottom: 40px;
        }

        .alterar-wrap {
            max-width: 1180px;
            margin: 0 auto;
            padding: 32px 16px;
        }

        .alterar-head {
            color: #f4f7fb;
            margin-bottom: 20px;
        }

        .alterar-head h1 {
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .alterar-head p {
            margin: 0;
            opacity: 0.9;
        }

        .alterar-tools {
            margin-top: 14px;
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .busca-input {
            width: min(420px, 100%);
            border: 1px solid rgba(224, 233, 247, 0.75);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.95);
            padding: 10px 12px;
            color: #1d2f47;
            font-weight: 600;
        }

        .busca-input::placeholder {
            color: #6d7e97;
            font-weight: 500;
        }

        .filtros-admin {
            margin-top: 12px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 12px;
        }

        .filtros-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 8px;
        }

        .filtro-campo {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .filtro-campo label {
            font-size: 0.74rem;
            color: #e9f1fc;
            font-weight: 700;
        }

        .filtro-campo input,
        .filtro-campo select {
            border: 1px solid #d0d9e8;
            border-radius: 8px;
            height: 36px;
            padding: 0 10px;
            font-size: 0.88rem;
            color: #1f3149;
            background: #fff;
        }

        .filtro-campo.filtro-area {
            grid-column: span 2;
        }

        .filtro-area-wrap {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .filtros-acoes {
            display: flex;
            align-items: end;
        }

        .btn-limpar-filtros {
            border: 0;
            border-radius: 8px;
            background: #e8eef8;
            color: #1f3149;
            height: 36px;
            width: 100%;
            font-weight: 700;
            font-size: 0.84rem;
        }

        .feedback-box {
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .feedback-success {
            background: #e7f8ed;
            color: #0f6b2a;
        }

        .feedback-error {
            background: #fdeceb;
            color: #9b1c1c;
        }

        .imoveis-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
            gap: 16px;
        }

        .imovel-card {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 10px 26px rgba(0, 0, 0, 0.12);
        }

        .imovel-card h2 {
            font-size: 1rem;
            margin-bottom: 12px;
            color: #11263a;
        }

        .campo {
            margin-bottom: 10px;
        }

        .campo label {
            display: block;
            font-size: 0.82rem;
            color: #364a5f;
            margin-bottom: 4px;
            font-weight: 600;
        }

        .campo input,
        .campo select,
        .campo textarea {
            width: 100%;
            border: 1px solid #cfd8e2;
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 0.95rem;
        }

        .campo textarea {
            min-height: 84px;
            resize: vertical;
        }

        .imagem-atual {
            width: 100%;
            max-height: 170px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #cfd8e2;
            margin-bottom: 8px;
        }

        .imagens-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 8px;
        }

        .imagem-miniatura {
            width: 100%;
            height: 86px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #cfd8e2;
            background: #f3f6fa;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        }

        .imagem-miniatura:hover {
            transform: translateY(-1px);
            border-color: #9cb5db;
        }

        .imagem-miniatura.principal {
            border-color: #1f5eff;
            box-shadow: 0 0 0 2px rgba(31, 94, 255, 0.16);
        }

        .imagem-item {
            position: relative;
        }

        .btn-remover-imagem {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 22px;
            height: 22px;
            padding: 0;
            border: 0;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            appearance: none;
            background: rgba(255, 255, 255, 0.92);
            color: #cf2b2b;
            font-size: 0.95rem;
            font-weight: 700;
            line-height: 1;
            cursor: pointer;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
        }

        .btn-remover-imagem i {
            line-height: 1;
            pointer-events: none;
        }

        .btn-remover-imagem:hover {
            background: #fff;
            color: #b61f1f;
        }

        .imagens-legenda {
            color: #5f7188;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .linha-dupla {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .checkbox-campo {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 10px 0;
            color: #203244;
            font-weight: 600;
        }

        .acoes {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }

        .btn-admin {
            border: 0;
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
        }

        .btn-salvar {
            background: #0d8f5b;
            flex: 1;
        }

        .btn-excluir {
            background: #c62828;
            flex: 1;
        }

        .estado-vazio {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 12px;
            padding: 18px;
            text-align: center;
            color: #26384a;
            font-weight: 600;
        }

        .paginacao-wrap {
            margin-top: 18px;
            display: flex;
            justify-content: center;
        }

        .paginacao {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .paginacao button {
            border: 1px solid #d2d9e5;
            background: #fff;
            color: #21334a;
            border-radius: 8px;
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            font-weight: 700;
        }

        .paginacao button.ativo {
            background: #1f5eff;
            border-color: #1f5eff;
            color: #fff;
        }

        .paginacao button:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        #alterar-toast {
            width: fit-content;
            max-width: min(92vw, 460px);
        }

        #alterar-toast .toast-body {
            white-space: nowrap;
        }

        .delete-modal .modal-content {
            border: 0;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 24px 50px rgba(0, 0, 0, 0.28);
        }

        .delete-modal .modal-header {
            border-bottom: 1px solid #edf1f7;
            background: linear-gradient(135deg, #fff7f7, #fff);
            padding: 14px 16px;
        }

        .delete-modal .modal-title {
            color: #9b1c1c;
            font-weight: 800;
            font-size: 1.02rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .delete-modal .modal-body {
            color: #30445a;
            font-size: 0.96rem;
            line-height: 1.5;
            padding: 16px;
        }

        .delete-modal .modal-footer {
            border-top: 1px solid #edf1f7;
            padding: 12px 16px 14px;
            gap: 8px;
        }

        .delete-modal .btn-cancelar-exclusao {
            border: 1px solid #cfd8e6;
            background: #fff;
            color: #29405a;
            font-weight: 700;
            border-radius: 10px;
            padding: 7px 14px;
        }

        .delete-modal .btn-confirmar-exclusao {
            border: 0;
            background: #c62828;
            color: #fff;
            font-weight: 700;
            border-radius: 10px;
            padding: 7px 14px;
        }

        .delete-modal .btn-confirmar-exclusao:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        @@media (max-width: 768px) {
            .linha-dupla {
                grid-template-columns: 1fr;
            }

            .filtros-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .filtro-campo.filtro-area {
                grid-column: span 2;
            }

            .imagens-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
    </style>
}

<main class="alterar-page" id="alterar-imoveis-app" v-cloak>
    <partial name="_Header" />

    <div class="alterar-wrap">
        <div class="alterar-head">
            <h1>Gerenciar imóveis cadastrados</h1>
            <p>Visualize todos os imóveis, atualize os dados e exclua registros quando necessário.</p>
            <div class="alterar-tools">
                <input type="text" class="busca-input" v-model.trim="busca"
                       placeholder="Buscar por ID ou título do imóvel" />
                <span class="text-light small fw-semibold">[[ imoveisFiltrados.length ]] resultado(s)</span>
            </div>

            <div class="filtros-admin">
                <div class="filtros-grid">
                    <div class="filtro-campo">
                        <label>Dormitórios</label>
                        <select v-model="filtros.dormitorios">
                            <option value="">Todos</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5 ou mais</option>
                        </select>
                    </div>

                    <div class="filtro-campo">
                        <label>Estado</label>
                        <select v-model="filtros.estado">
                            <option value="">Todos</option>
                            <option v-for="uf in estadosDisponiveis" :key="`uf-${uf}`" :value="uf">[[ uf ]]</option>
                        </select>
                    </div>

                    <div class="filtro-campo">
                        <label>Negócio</label>
                        <select v-model="filtros.negocio">
                            <option value="">Todos</option>
                            <option value="compra">Compra</option>
                            <option value="aluguel">Aluguel</option>
                        </select>
                    </div>

                    <div class="filtro-campo">
                        <label>Tipo</label>
                        <select v-model="filtros.tipo">
                            <option value="">Todos</option>
                            <option value="casa">Casa</option>
                            <option value="apartamento">Apartamento</option>
                        </select>
                    </div>

                    <div class="filtro-campo">
                        <label>Com garagem</label>
                        <select v-model="filtros.garagem">
                            <option value="">Todos</option>
                            <option value="true">Sim</option>
                            <option value="false">Não</option>
                        </select>
                    </div>

                    <div class="filtro-campo">
                        <label>Bairro</label>
                        <input type="text" v-model.trim="filtros.bairro" placeholder="Ex: Centro" />
                    </div>

                    <div class="filtro-campo">
                        <label>Cidade</label>
                        <input type="text" v-model.trim="filtros.cidade" placeholder="Ex: São Paulo" />
                    </div>

                    <div class="filtro-campo filtro-area">
                        <label>Área (m²)</label>
                        <div class="filtro-area-wrap">
                            <input type="number" min="0" step="0.01" v-model.number="filtros.areaMin"
                                   placeholder="Mínima" />
                            <input type="number" min="0" step="0.01" v-model.number="filtros.areaMax"
                                   placeholder="Máxima" />
                        </div>
                    </div>

                    <div class="filtros-acoes">
                        <button type="button" class="btn-limpar-filtros" @@click="limparFiltros()">Limpar
                            filtros</button>
                        </div>
                    </div>
                </div>
            </div>

            <div v-if="carregando" class="estado-vazio">
                Carregando imóveis...
            </div>

            <div v-else-if="imoveis.length === 0" class="estado-vazio">
                Nenhum imóvel cadastrado no sistema.
            </div>

            <div v-else-if="imoveisFiltrados.length === 0" class="estado-vazio">
                Nenhum imóvel encontrado para "[[ busca ]]".
            </div>

            <div v-else class="imoveis-grid">
                <article class="imovel-card" v-for="imovel in imoveisPaginados" :key="imovel.id">
                    <h2># [[ imovel.id ]] - [[ imovel.titulo ]]</h2>

                    <div class="campo">
                        <label>Título</label>
                        <input type="text" v-model="imovel.titulo" maxlength="150" />
                    </div>

                    <div class="linha-dupla">
                        <div class="campo">
                            <label>Tipo</label>
                            <select v-model="imovel.tipo">
                                <option value="casa">Casa</option>
                                <option value="apartamento">Apartamento</option>
                            </select>
                        </div>
                        <div class="campo">
                            <label>Negócio</label>
                            <select v-model="imovel.negocio">
                                <option value="compra">Compra</option>
                                <option value="aluguel">Aluguel</option>
                            </select>
                        </div>
                    </div>

                    <div class="linha-dupla">
                        <div class="campo">
                            <label>Dormitórios</label>
                            <input type="number" min="1" max="99" v-model.number="imovel.dormitorios" />
                        </div>
                        <div class="campo">
                            <label>Estado (UF)</label>
                            <input type="text" maxlength="2" v-model="imovel.estado" />
                        </div>
                    </div>

                    <div class="linha-dupla">
                        <div class="campo">
                            <label>Área (m²)</label>
                            <input type="number" min="1" step="0.01" v-model.number="imovel.areaM2" />
                        </div>
                        <div class="campo">
                            <label>Preço (R$)</label>
                            <input type="text" inputmode="numeric" :value="imovel.precoFormatado"
                            @@input="atualizarPrecoFormatado(imovel, $event)" />
                        </div>
                    </div>

                    <div class="linha-dupla">
                        <div class="campo">
                            <label>Bairro</label>
                            <input type="text" maxlength="100" v-model="imovel.bairro" />
                        </div>
                        <div class="campo">
                            <label>Cidade</label>
                            <input type="text" maxlength="100" v-model="imovel.cidade" />
                        </div>
                    </div>

                    <div class="linha-dupla">
                        <div class="campo">
                            <label>CEP</label>
                            <input type="text" maxlength="9" v-model="imovel.cep"
                            @@input="atualizarCepFormatado(imovel, $event)" />
                        </div>
                        <div class="campo">
                            <label>Com garagem</label>
                            <select v-model="imovel.garagem">
                                <option :value="true">Sim</option>
                                <option :value="false">Não</option>
                            </select>
                        </div>
                    </div>

                    <div class="campo">
                        <label>Descrição</label>
                        <textarea v-model="imovel.descricao"></textarea>
                    </div>

                    <div class="campo">
                        <label>Imagem atual (principal)</label>
                        <img v-if="imovel.imagens && imovel.imagens.length > 0" :src="imovel.imagens[0]"
                             alt="Imagem do imóvel" class="imagem-atual" />
                        <div v-else class="text-muted small">Sem imagem cadastrada.</div>
                    </div>

                    <div class="campo">
                        <label>Todas as imagens associadas ([[ imovel.imagens ? imovel.imagens.length : 0 ]])</label>
                        <div v-if="imovel.imagens && imovel.imagens.length > 0" class="imagens-grid">
                            <div class="imagem-item" v-for="(imagem, indice) in imovel.imagens"
                                 :key="`${imovel.id}-img-${indice}`">
                                <img :src="imagem" :alt="`Imagem ${indice + 1} do imóvel ${imovel.titulo}`"
                                     class="imagem-miniatura" :class="{ principal: indice === 0 }"
                                     title="Clique para definir como principal"
                                @@click="definirPrincipalExistente(imovel, indice)" />
                                <button type="button" class="btn-remover-imagem"
                                @@click.stop="removerImagemExistente(imovel, indice)" title="Remover imagem"
                                        aria-label="Remover imagem"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </div>
                        <div v-else class="text-muted small">Sem imagens adicionais cadastradas.</div>
                        <div class="imagens-legenda" v-if="imovel.imagens && imovel.imagens.length > 1">
                            Clique em uma miniatura para definir a principal da listagem pública.
                        </div>
                    </div>

                    <div class="campo">
                        <label>Atualizar imagens</label>
                        <input type="file" accept="image/*" multiple @@change="selecionarImagens($event, imovel)" />
                        <div class="text-muted small" v-if="imovel.novasImagensCount > 0">[[ imovel.novasImagensCount ]]
                            nova(s) imagem(ns) selecionada(s).</div>
                            <div class="text-muted small" v-else>Nenhuma nova imagem selecionada (mantém as atuais).</div>
                            <div class="imagens-grid" v-if="imovel.novasImagens && imovel.novasImagens.length > 0">
                                <div class="imagem-item" v-for="(imagemNova, indiceNova) in imovel.novasImagens"
                                     :key="`${imovel.id}-nova-${indiceNova}`">
                                    <img :src="imagemNova" :alt="`Nova imagem ${indiceNova + 1} para ${imovel.titulo}`"
                                         class="imagem-miniatura" :class="{ principal: indiceNova === 0 }"
                                         title="Clique para definir como principal entre as novas"
                                    @@click="definirPrincipalNova(imovel, indiceNova)" />
                                    <button type="button" class="btn-remover-imagem"
                                    @@click.stop="removerImagemNova(imovel, indiceNova)" title="Remover imagem"
                                            aria-label="Remover imagem"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="acoes">
                            <button class="btn-admin btn-salvar" type="button" @@click="salvarImovel(imovel)"
                                    :disabled="processandoId === imovel.id">
                                Salvar
                            </button>
                            <button class="btn-admin btn-excluir" type="button" @@click="excluirImovel(imovel.id)"
                                    :disabled="processandoId === imovel.id">
                                Excluir
                            </button>
                        </div>
                    </article>
                </div>

                <div class="paginacao-wrap" v-if="totalPaginas > 1">
                    <div class="paginacao">
                        <button type="button" @@click="irParaPagina(paginaAtual - 1)"
                                :disabled="paginaAtual === 1">&lsaquo;</button>
                        <button type="button" v-for="pagina in totalPaginas" :key="`pagina-${pagina}`"
                                :class="{ ativo: pagina === paginaAtual }" @@click="irParaPagina(pagina)">
                            [[ pagina ]]
                        </button>
                        <button type="button" @@click="irParaPagina(paginaAtual + 1)"
                                :disabled="paginaAtual === totalPaginas">&rsaquo;</button>
                    </div>
                </div>
            </div>
        </main>

        <form id="csrf-form" method="post" style="display:none;">
            @Html.AntiForgeryToken()
        </form>

        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
            <div id="alterar-toast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive"
                 aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body" id="alterar-toast-body">Operação concluída.</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
            </div>
        </div>

        <div class="modal fade delete-modal" id="deleteConfirmModal" tabindex="-1"
             aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteConfirmModalLabel">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Confirmar exclusão
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Tem certeza que deseja excluir este imóvel? Esta ação não pode ser desfeita.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-cancelar-exclusao" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="delete-confirm-button" class="btn-confirmar-exclusao">
                            Excluir imóvel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                const MAX_LADO_IMAGEM = 1600;
                const QUALIDADE_INICIAL_JPEG = 0.78;
                const QUALIDADE_MINIMA_JPEG = 0.45;
                const LIMITE_IMAGEM_BYTES = 700 * 1024;
                const LIMITE_TOTAL_BYTES = 3 * 1024 * 1024;
                const csrfToken = document.querySelector('#csrf-form input[name="__RequestVerificationToken"]')?.value || '';

                const alterarImoveisApp = Vue.createApp({
                    delimiters: ['[[', ']]'],
                    data() {
                        return {
                            imoveis: [],
                            busca: '',
                            filtros: {
                                dormitorios: '',
                                estado: '',
                                negocio: '',
                                tipo: '',
                                bairro: '',
                                cidade: '',
                                garagem: '',
                                areaMin: null,
                                areaMax: null
                            },
                            paginaAtual: 1,
                            itensPorPagina: 3,
                            carregando: true,
                            processandoId: null,
                            toast: null,
                            pendingDeleteId: null,
                            deleteModal: null
                        };
                    },
                    computed: {
                        estadosDisponiveis() {
                            const estados = this.imoveis
                                .map(i => String(i.estado || '').toUpperCase())
                                .filter(Boolean);
                            return [...new Set(estados)].sort();
                        },
                        imoveisFiltrados() {
                            const termo = (this.busca || '').trim().toLowerCase();
                            const bairroFiltro = (this.filtros.bairro || '').toLowerCase();
                            const cidadeFiltro = (this.filtros.cidade || '').toLowerCase();
                            const areaMinFiltro = this.parseNumeroFiltro(this.filtros.areaMin);
                            const areaMaxFiltro = this.parseNumeroFiltro(this.filtros.areaMax);

                            return this.imoveis.filter(imovel => {
                                const idTexto = String(imovel.id || '');
                                const tituloTexto = String(imovel.titulo || '').toLowerCase();
                                const estadoTexto = String(imovel.estado || '').toUpperCase();
                                const negocioTexto = String(imovel.negocio || '').toLowerCase();
                                const tipoTexto = String(imovel.tipo || '').toLowerCase();
                                const bairroTexto = String(imovel.bairro || '').toLowerCase();
                                const cidadeTexto = String(imovel.cidade || '').toLowerCase();
                                const dormitorios = Number(imovel.dormitorios || 0);
                                const area = Number(imovel.areaM2 || 0);

                                const bateBusca = !termo || idTexto.includes(termo) || tituloTexto.includes(termo);
                                if (!bateBusca) return false;

                                if (this.filtros.dormitorios) {
                                    const dormFiltro = Number(this.filtros.dormitorios);
                                    if (dormFiltro >= 5 && dormitorios < 5) return false;
                                    if (dormFiltro < 5 && dormitorios !== dormFiltro) return false;
                                }

                                if (this.filtros.estado && estadoTexto !== this.filtros.estado) return false;
                                if (this.filtros.negocio && negocioTexto !== this.filtros.negocio) return false;
                                if (this.filtros.tipo && tipoTexto !== this.filtros.tipo) return false;
                                if (bairroFiltro && !bairroTexto.includes(bairroFiltro)) return false;
                                if (cidadeFiltro && !cidadeTexto.includes(cidadeFiltro)) return false;

                                if (this.filtros.garagem === 'true' && !imovel.garagem) return false;
                                if (this.filtros.garagem === 'false' && !!imovel.garagem) return false;

                                if (areaMinFiltro !== null && areaMaxFiltro !== null) {
                                    if (area < areaMinFiltro || area > areaMaxFiltro) return false;
                                } else if (areaMinFiltro !== null) {
                                    if (area < areaMinFiltro) return false;
                                } else if (areaMaxFiltro !== null) {
                                    if (area !== areaMaxFiltro) return false;
                                }

                                return true;
                            });
                        },
                        totalPaginas() {
                            return Math.max(1, Math.ceil(this.imoveisFiltrados.length / this.itensPorPagina));
                        },
                        imoveisPaginados() {
                            const inicio = (this.paginaAtual - 1) * this.itensPorPagina;
                            return this.imoveisFiltrados.slice(inicio, inicio + this.itensPorPagina);
                        }
                    },
                    watch: {
                        busca() {
                            this.paginaAtual = 1;
                        },
                        filtros: {
                            deep: true,
                            handler() {
                                this.paginaAtual = 1;
                            }
                        }
                    },
                    methods: {
                        parseNumeroFiltro(valor) {
                            if (valor === null || valor === undefined || valor === '') {
                                return null;
                            }

                            const textoNormalizado = String(valor).replace(',', '.').trim();
                            const numero = Number(textoNormalizado);
                            return Number.isFinite(numero) ? numero : null;
                        },
                        limparFiltros() {
                            this.filtros = {
                                dormitorios: '',
                                estado: '',
                                negocio: '',
                                tipo: '',
                                bairro: '',
                                cidade: '',
                                garagem: '',
                                areaMin: null,
                                areaMax: null
                            };
                            this.busca = '';
                        },
                        irParaPagina(pagina) {
                            if (pagina < 1 || pagina > this.totalPaginas) {
                                return;
                            }

                            this.paginaAtual = pagina;
                        },
                        mostrarMensagem(texto, tipo = 'success') {
                            const toastElement = document.getElementById('alterar-toast');
                            const toastBody = document.getElementById('alterar-toast-body');

                            if (!toastElement || !toastBody || !this.toast) {
                                return;
                            }

                            toastBody.textContent = texto;
                            toastElement.classList.remove('text-bg-success', 'text-bg-danger');
                            toastElement.classList.add(tipo === 'success' ? 'text-bg-success' : 'text-bg-danger');
                            this.toast.show();
                        },
                        abrirConfirmacaoExclusao(id) {
                            this.pendingDeleteId = id;
                            const confirmButton = document.getElementById('delete-confirm-button');
                            if (confirmButton) {
                                confirmButton.disabled = false;
                            }

                            if (!this.deleteModal) {
                                const modalElement = document.getElementById('deleteConfirmModal');
                                this.deleteModal = modalElement ? new bootstrap.Modal(modalElement) : null;
                            }

                            if (this.deleteModal) {
                                this.deleteModal.show();
                            }
                        },
                        async confirmarExclusao() {
                            if (this.pendingDeleteId === null) {
                                return;
                            }

                            const id = this.pendingDeleteId;
                            const confirmButton = document.getElementById('delete-confirm-button');
                            if (confirmButton) {
                                confirmButton.disabled = true;
                            }

                            this.processandoId = id;
                            try {
                                const response = await fetch(`/Home/ExcluirImovel/${id}`, {
                                    method: 'DELETE',
                                    headers: {
                                        'X-CSRF-TOKEN': csrfToken
                                    }
                                });

                                const data = await response.json().catch(() => ({}));

                                if (!response.ok) {
                                    throw new Error(data.mensagem || 'Falha ao excluir imóvel.');
                                }

                                this.imoveis = this.imoveis.filter(i => i.id !== id);
                                this.mostrarMensagem(data.mensagem || 'Imóvel excluído com sucesso.', 'success');
                                this.deleteModal?.hide();
                                this.pendingDeleteId = null;
                            } catch (error) {
                                this.mostrarMensagem(error.message || 'Erro ao excluir imóvel.', 'error');
                            } finally {
                                this.processandoId = null;
                                if (confirmButton) {
                                    confirmButton.disabled = this.pendingDeleteId === null;
                                }
                            }
                        },
                        async carregarImoveis() {
                            this.carregando = true;
                            try {
                                const response = await fetch('/Home/ListarImoveisAdmin');

                                if (response.status === 401) {
                                    window.location.href = '/Home/Login';
                                    return;
                                }

                                if (response.status === 403) {
                                    window.location.href = '/Home/Index';
                                    return;
                                }

                                if (!response.ok) {
                                    throw new Error('Não foi possível listar os imóveis.');
                                }

                                const dados = await response.json();
                                this.imoveis = Array.isArray(dados)
                                    ? dados.map(imovel => ({
                                        ...imovel,
                                        imagens: Array.isArray(imovel.imagens) ? [...imovel.imagens] : [],
                                        cep: this.formatarCep(imovel.cep),
                                        novasImagens: [],
                                        novasImagensCount: 0,
                                        ordemImagensAlterada: false,
                                        imagensRemovidas: false,
                                        precoFormatado: this.formatarMoedaBRL(Number(imovel.preco || 0))
                                    }))
                                    : [];

                                this.paginaAtual = 1;
                            } catch {
                                this.imoveis = [];
                                this.mostrarMensagem('Erro ao carregar os imóveis.', 'error');
                            } finally {
                                this.carregando = false;
                            }
                        },
                        montarPayload(imovel) {
                            const imagensExistentes = Array.isArray(imovel.imagens)
                                ? [...imovel.imagens]
                                : [];

                            const novasImagens = imovel.novasImagens && imovel.novasImagens.length > 0
                                ? [...imovel.novasImagens]
                                : null;

                            const imagensReordenadas = !novasImagens && (imovel.ordemImagensAlterada || imovel.imagensRemovidas)
                                ? (imovel.imagens || [])
                                : null;

                            const imagensComAcrescimo = novasImagens
                                ? [...imagensExistentes, ...novasImagens]
                                : null;

                            return {
                                titulo: (imovel.titulo || '').trim(),
                                tipo: (imovel.tipo || '').trim(),
                                negocio: (imovel.negocio || '').trim(),
                                bairro: (imovel.bairro || '').trim() || null,
                                cidade: (imovel.cidade || '').trim(),
                                estado: (imovel.estado || '').trim().toUpperCase(),
                                cep: (imovel.cep || '').trim() || null,
                                dormitorios: Number(imovel.dormitorios),
                                garagem: !!imovel.garagem,
                                areaM2: Number(imovel.areaM2),
                                preco: this.extrairNumeroMoeda(imovel.precoFormatado),
                                descricao: (imovel.descricao || '').trim() || null,
                                imagens: imagensComAcrescimo || imagensReordenadas
                            };
                        },
                        formatarMoedaBRL(valor) {
                            return Number(valor || 0).toLocaleString('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            });
                        },
                        extrairNumeroMoeda(valorTexto) {
                            const apenasDigitos = String(valorTexto || '').replace(/\D/g, '');
                            if (!apenasDigitos) {
                                return 0;
                            }

                            return Number(apenasDigitos) / 100;
                        },
                        formatarCep(valorTexto) {
                            const digitos = String(valorTexto || '').replace(/\D/g, '').slice(0, 8);
                            if (digitos.length <= 5) {
                                return digitos;
                            }

                            return `${digitos.slice(0, 5)}-${digitos.slice(5)}`;
                        },
                        atualizarCepFormatado(imovel, evento) {
                            imovel.cep = this.formatarCep(evento.target.value);
                        },
                        atualizarPrecoFormatado(imovel, evento) {
                            const valorNumerico = this.extrairNumeroMoeda(evento.target.value);
                            imovel.precoFormatado = valorNumerico > 0
                                ? this.formatarMoedaBRL(valorNumerico)
                                : '';
                        },
                        moverImagemParaInicio(lista, indice) {
                            if (!Array.isArray(lista) || indice < 0 || indice >= lista.length) {
                                return lista || [];
                            }

                            const copia = [...lista];
                            const [selecionada] = copia.splice(indice, 1);
                            copia.unshift(selecionada);
                            return copia;
                        },
                        definirPrincipalExistente(imovel, indice) {
                            if (!imovel || !Array.isArray(imovel.imagens) || indice === 0) {
                                return;
                            }

                            imovel.imagens = this.moverImagemParaInicio(imovel.imagens, indice);
                            imovel.ordemImagensAlterada = true;
                            this.mostrarMensagem('Imagem principal atualizada. Clique em Salvar para confirmar.', 'success');
                        },
                        definirPrincipalNova(imovel, indice) {
                            if (!imovel || !Array.isArray(imovel.novasImagens) || indice === 0) {
                                return;
                            }

                            imovel.novasImagens = this.moverImagemParaInicio(imovel.novasImagens, indice);
                            this.mostrarMensagem('Ordem das novas imagens atualizada.', 'success');
                        },
                        removerImagemExistente(imovel, indice) {
                            if (!imovel || !Array.isArray(imovel.imagens) || indice < 0 || indice >= imovel.imagens.length) {
                                return;
                            }

                            imovel.imagens.splice(indice, 1);
                            imovel.imagensRemovidas = true;
                            imovel.ordemImagensAlterada = true;
                            this.mostrarMensagem('Imagem removida. Clique em Salvar para confirmar.', 'success');
                        },
                        removerImagemNova(imovel, indice) {
                            if (!imovel || !Array.isArray(imovel.novasImagens) || indice < 0 || indice >= imovel.novasImagens.length) {
                                return;
                            }

                            imovel.novasImagens.splice(indice, 1);
                            imovel.novasImagensCount = imovel.novasImagens.length;
                            this.mostrarMensagem('Nova imagem removida da seleção.', 'success');
                        },
                        calcularBytesDataUrl(dataUrl) {
                            const base64 = (String(dataUrl || '').split(',')[1] || '');
                            return Math.ceil((base64.length * 3) / 4);
                        },
                        carregarImagemArquivo(arquivo) {
                            return new Promise((resolve, reject) => {
                                const objectUrl = URL.createObjectURL(arquivo);
                                const imagem = new Image();
                                imagem.onload = () => {
                                    URL.revokeObjectURL(objectUrl);
                                    resolve(imagem);
                                };
                                imagem.onerror = () => {
                                    URL.revokeObjectURL(objectUrl);
                                    reject(new Error('Falha ao carregar arquivo de imagem.'));
                                };
                                imagem.src = objectUrl;
                            });
                        },
                        async arquivoParaBase64(arquivo) {
                            if (!arquivo.type || !arquivo.type.startsWith('image/')) {
                                throw new Error('Selecione apenas arquivos de imagem.');
                            }

                            const imagem = await this.carregarImagemArquivo(arquivo);
                            const escala = Math.min(1, MAX_LADO_IMAGEM / imagem.width, MAX_LADO_IMAGEM / imagem.height);
                            const largura = Math.max(1, Math.round(imagem.width * escala));
                            const altura = Math.max(1, Math.round(imagem.height * escala));

                            const canvas = document.createElement('canvas');
                            canvas.width = largura;
                            canvas.height = altura;

                            const contexto = canvas.getContext('2d');
                            if (!contexto) {
                                throw new Error('Não foi possível processar a imagem selecionada.');
                            }

                            contexto.drawImage(imagem, 0, 0, largura, altura);

                            let qualidade = QUALIDADE_INICIAL_JPEG;
                            let dataUrl = canvas.toDataURL('image/jpeg', qualidade);

                            while (this.calcularBytesDataUrl(dataUrl) > LIMITE_IMAGEM_BYTES && qualidade > QUALIDADE_MINIMA_JPEG) {
                                qualidade = Math.max(QUALIDADE_MINIMA_JPEG, qualidade - 0.08);
                                dataUrl = canvas.toDataURL('image/jpeg', qualidade);
                            }

                            if (this.calcularBytesDataUrl(dataUrl) > LIMITE_IMAGEM_BYTES) {
                                throw new Error(`A imagem "${arquivo.name}" está muito grande. Use uma imagem menor.`);
                            }

                            return dataUrl;
                        },
                        async selecionarImagens(evento, imovel) {
                            const arquivos = Array.from(evento.target.files || []);
                            if (arquivos.length === 0) {
                                imovel.novasImagens = [];
                                imovel.novasImagensCount = 0;
                                return;
                            }

                            try {
                                const imagensBase64 = await Promise.all(arquivos.map(a => this.arquivoParaBase64(a)));
                                const totalBytes = imagensBase64.reduce((acc, img) => acc + this.calcularBytesDataUrl(img), 0);
                                if (totalBytes > LIMITE_TOTAL_BYTES) {
                                    throw new Error('As imagens selecionadas somadas ficaram muito grandes. Selecione menos imagens ou imagens menores.');
                                }

                                imovel.novasImagens = imagensBase64;
                                imovel.novasImagensCount = imagensBase64.length;
                            } catch (error) {
                                imovel.novasImagens = [];
                                imovel.novasImagensCount = 0;
                                this.mostrarMensagem(error.message || 'Não foi possível processar as imagens selecionadas.', 'error');
                            }
                        },
                        async salvarImovel(imovel) {
                            this.processandoId = imovel.id;
                            try {
                                const response = await fetch(`/Home/AtualizarImovel/${imovel.id}`, {
                                    method: 'PUT',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'X-CSRF-TOKEN': csrfToken
                                    },
                                    body: JSON.stringify(this.montarPayload(imovel))
                                });

                                const data = await response.json().catch(() => ({}));

                                if (!response.ok) {
                                    throw new Error(data.mensagem || 'Falha ao atualizar imóvel.');
                                }

                                if (imovel.novasImagens && imovel.novasImagens.length > 0) {
                                    imovel.imagens = [...(imovel.imagens || []), ...imovel.novasImagens];
                                    imovel.novasImagens = [];
                                    imovel.novasImagensCount = 0;
                                }

                                imovel.ordemImagensAlterada = false;
                                imovel.imagensRemovidas = false;

                                this.mostrarMensagem(data.mensagem || 'Imóvel atualizado com sucesso.', 'success');
                            } catch (error) {
                                this.mostrarMensagem(error.message || 'Erro ao atualizar imóvel.', 'error');
                            } finally {
                                this.processandoId = null;
                            }
                        },
                        excluirImovel(id) {
                            this.abrirConfirmacaoExclusao(id);
                        }
                    },
                    mounted() {
                        const toastElement = document.getElementById('alterar-toast');
                        this.toast = toastElement ? new bootstrap.Toast(toastElement, { delay: 2200 }) : null;
                        const deleteModalElement = document.getElementById('deleteConfirmModal');
                        this.deleteModal = deleteModalElement ? new bootstrap.Modal(deleteModalElement) : null;

                        const confirmButton = document.getElementById('delete-confirm-button');
                        if (confirmButton) {
                            confirmButton.addEventListener('click', () => {
                                this.confirmarExclusao();
                            });
                            confirmButton.disabled = true;
                        }

                        if (deleteModalElement) {
                            deleteModalElement.addEventListener('hidden.bs.modal', () => {
                                this.pendingDeleteId = null;
                                if (confirmButton) {
                                    confirmButton.disabled = true;
                                }
                            });
                        }

                        this.carregarImoveis();
                    }
                });

                alterarImoveisApp.mount('#alterar-imoveis-app');
            </script>
        }
